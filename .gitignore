vendor/cef/Release/*.dll
vendor/cef/Release/*.exe
vendor/cef/Release/*.bin
vendor/cef/Resources/
vendor/cef/tests/
vendor/cef/bin/
vendor/cef/BUILD.bazel
vendor/cef/WORKSPACE
vendor/cef/Doxyfile
vendor/cef/CREDITS.html

# Exclude
!vendor/bin