# Directories
.vs/
bin/
bin-int/

# Files
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.sln
*.slnx
imgui.ini

# CEF binaries and build artifacts (exclude DLLs, EXEs, large binaries)
vendor/cef/Debug/*.dll
vendor/cef/Debug/*.exe
